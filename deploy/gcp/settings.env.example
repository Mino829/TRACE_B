# Closed staging only. Copy to settings.env; never put secret payloads here.
# Existing preview IAM/Edge protection is preserved; trace-backend stays stopped.
GCP_PROJECT_ID=trace-staging-async5855
GCP_REGION=asia-northeast1
GCP_SQL_CONNECTION=trace-staging-async5855:asia-northeast1:trace-postgres
# Build the reviewed release, then resolve its immutable Artifact Registry digest.
GCP_IMAGE=asia-northeast1-docker.pkg.dev/trace-staging-async5855/trace/backend@sha256:REPLACE_REVIEWED_IMAGE_DIGEST
GCP_API_RUNTIME_SA=trace-preview-runtime@trace-staging-async5855.iam.gserviceaccount.com
GCP_CLEANUP_RUNTIME_SA=trace-runtime@trace-staging-async5855.iam.gserviceaccount.com
GCP_MIGRATION_SA=trace-migration@trace-staging-async5855.iam.gserviceaccount.com
GCP_SCHEDULER_SA=trace-scheduler@trace-staging-async5855.iam.gserviceaccount.com
# Pin numeric Secret Manager versions for reproducible releases.
GCP_APP_PASSWORD_SECRET=trace-app-db-password:1
GCP_OWNER_PASSWORD_SECRET=trace-owner-db-password:1
# Required API-only Edge reference; already configured on the existing preview.
# Never put the value in settings, runtime YAML, command arguments or logs.
GCP_EDGE_SHARED_SECRET=trace-preview-edge-secret:2
# Set during an explicitly approved maintenance window, not during PR preparation.
# After quiesce AND verified old-request/instance drain:
# export GCP_QUIESCED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# Create an on-demand backup AFTER that point and record its numeric ID.
GCP_QUIESCED_AT=
GCP_BACKUP_ID=
