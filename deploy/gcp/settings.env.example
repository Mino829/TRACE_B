# Non-secret deployment metadata. Copy to settings.env; do not put passwords here.
GCP_PROJECT_ID=replace-project-id
GCP_REGION=asia-northeast1
GCP_SQL_CONNECTION=replace-project-id:asia-northeast1:trace-postgres
GCP_IMAGE=asia-northeast1-docker.pkg.dev/replace-project-id/trace/backend:replace-release-tag
GCP_RUNTIME_SA=trace-runtime@replace-project-id.iam.gserviceaccount.com
GCP_MIGRATION_SA=trace-migration@replace-project-id.iam.gserviceaccount.com
GCP_SCHEDULER_SA=trace-scheduler@replace-project-id.iam.gserviceaccount.com
# Pin numeric Secret Manager versions for reproducible releases.
GCP_APP_PASSWORD_SECRET=trace-app-db-password:1
GCP_OWNER_PASSWORD_SECRET=trace-owner-db-password:1
# Optional on the private Backend; required before enabling the Worker edge.
# Pin a numeric version; never put the secret value in this file or runtime.env.yaml.
# GCP_EDGE_SHARED_SECRET=trace-edge-shared-secret:1
# Optional booth QR: pin two independent secret versions; API only, not cleanup.
# GCP_ARRIVAL_ISSUER_SECRET=trace-arrival-issuer:1
# GCP_ARRIVAL_PROOF_SECRET=trace-arrival-proof:1
# Optional display token signing key; Google client ID, operator emails and
# display origins belong in runtime.env.yaml. API only; pin a numeric secret version.
# GCP_DISPLAY_TOKEN_SECRET=trace-display-token-key:1
