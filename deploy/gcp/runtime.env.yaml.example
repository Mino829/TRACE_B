# Closed staging profile; deploy.sh refuses to enable intake/photo/push/arrival/display/operator.
# This notice and draft consent version are NOT approved participant consent.
# DB_PASSWORD and the API-only Edge key are injected by numbered Secret references.
DB_HOST: "/cloudsql/trace-staging-async5855:asia-northeast1:trace-postgres"
DB_NAME: "trace"
DB_USER: "trace_app"
# Only the local Unix socket leg is unencrypted; Cloud SQL Auth Proxy encrypts the remote leg.
DB_SSLMODE: "disable"
TRACE_DB_MAX_CONNECTIONS: "5"
TRACE_REGISTRATION_OPEN: "false"
# Keep registration closed pending review of device-only consent and frontend integration.
TRACE_PHOTO_METADATA_ENABLED: "false"
# Old cloud uploads must remain off when device metadata is enabled.
TRACE_PHOTO_ENABLED: "false"
# Keep TRACE_PHOTO_BUCKET and TRACE_PHOTO_SIGNER_EMAIL configured on BOTH API and
# cleanup job until retained legacy photos and signed-upload fences are gone.
# Keep false. This closed rollout does not install optional display signing keys.
# Google OAuth and the direct browser route require a separately approved rollout.
TRACE_DISPLAY_ENABLED: "false"
# Same OAuth Web client ID as Frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Register the display origin below as an authorized JavaScript origin in Google.
TRACE_DISPLAY_GOOGLE_CLIENT_ID: "768829535838-9v4875nkjopo91uobrmggneqodmvec85.apps.googleusercontent.com"
# Explicitly approved operator account; do not add accounts without approval.
TRACE_DISPLAY_OPERATOR_EMAILS: "async5855@gmail.com"
TRACE_DISPLAY_ALLOWED_ORIGINS: "https://trace-log.async5855.workers.dev"
# Separate entitlement: enabling display never enables operator mutations.
TRACE_OPERATOR_ENABLED: "false"
TRACE_OPERATOR_GOOGLE_CLIENT_ID: "768829535838-9v4875nkjopo91uobrmggneqodmvec85.apps.googleusercontent.com"
TRACE_OPERATOR_EMAILS: "async5855@gmail.com"
TRACE_OPERATOR_ALLOWED_ORIGINS: "https://trace-log.async5855.workers.dev"
# Pinned bundle from TRACE_F main d0150a1f4d6fcd64b2eb6982cfcf72dae8c8600d.
TRACE_COORDINATE_VERSION: "toyosu-2026-08-28.1"
TRACE_CAMPUS_GRAPH_VERSION: "toyosu-graph-2026-10-29.1.draft"
TRACE_THREE_D_MAP_VERSION: "toyosu-3dmap-2026-10-29"
# Optional Web Push is disabled until approved. NEVER put private/encryption keys here.
TRACE_PUSH_ENABLED: "false"
# No optional Push/arrival keys are installed by this closed staging profile.
# Enabling these features requires approved consent and a separate deployment review.
TRACE_ARRIVAL_ENABLED: "false"
TRACE_ARRIVAL_PROOF_KEY_ID: "arrival-proof-v1"
TRACE_ALLOWED_ORIGINS: "https://trace-staging-preview.async5855.workers.dev"
# Keep the current unapproved draft version: it also blocks accidental registration.
TRACE_MEMORY_CONSENT_VERSION: "2026-memory-photo-no-gps-draft-1"
# Retained only for preexisting Live sessions; new Live registration is disabled.
TRACE_LIVE_CONSENT_VERSION: "2026-live-01"
TRACE_ON_SITE_CONSENT_VERSION: "2026-on-site-01"
TRACE_CONSENT_LANGUAGE: "ja"
TRACE_CONSENT_BODY: "検証環境では受付を停止しています。"
TRACE_CONTACT: "検証環境の管理者"
# New GPS input is retired. No campus GPS boundary is approved by this profile;
# the unused legacy geofence/origin settings retain Config.Default values.
TRACE_POSITION_QUANTIZATION_METERS: "10"
TRACE_MAX_POSITION_ACCURACY_METERS: "100"
TRACE_LIVE_POSITION_TTL: "60s"
TRACE_MEMORY_SESSION_TTL: "6h"
TRACE_LIVE_SESSION_TTL: "6h"
TRACE_DATA_RETENTION: "24h"
