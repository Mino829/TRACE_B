# Local development only. Use Secret Manager for production passwords.
POSTGRES_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_NAME=trace
DB_USER=trace
DB_PASSWORD=change-this-local-password
DB_SSLMODE=disable
PORT=8080
TRACE_DB_MAX_CONNECTIONS=5
TRACE_ALLOWED_ORIGINS=http://localhost:3000
TRACE_REGISTRATION_OPEN=false

# New device-only metadata is disabled until consent and frontend integration are approved.
TRACE_PHOTO_METADATA_ENABLED=false
# Legacy cloud uploads must stay off during the device-only cutover.
TRACE_PHOTO_ENABLED=false
# Keep both set while old photos or signed-upload fences still need reading/deletion.
TRACE_PHOTO_BUCKET=
TRACE_PHOTO_SIGNER_EMAIL=

# Optional Web Push. Keep disabled until consent text, provider egress and staging are approved.
TRACE_PUSH_ENABLED=false
# When enabled: uncompressed P-256 VAPID public key (65 bytes, base64url),
# private scalar (32 bytes, base64url), mailto: contact, and a DIFFERENT
# independent 32-byte base64url key for subscription encryption at rest.
TRACE_PUSH_VAPID_PUBLIC_KEY=
TRACE_PUSH_VAPID_PRIVATE_KEY=
TRACE_PUSH_VAPID_SUBJECT=
TRACE_PUSH_ENCRYPTION_KEY=

# Projected booth QR; keep disabled until operator route and consent review.
TRACE_ARRIVAL_ENABLED=false
TRACE_ARRIVAL_VENUE=
TRACE_ARRIVAL_CHECKPOINT_ID=
# Two distinct 32+ byte secrets; configure through Secret Manager in production.
TRACE_ARRIVAL_PROOF_KEY=
TRACE_ARRIVAL_ISSUER_KEY=


# Disabled until OAuth, direct-browser access and frontend integration are verified.
# Exact comma-delimited Gmail/Workspace operator emails and display origins.
TRACE_DISPLAY_ENABLED=false
# Use the SAME Web client ID as Frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Register this origin (without /display) in Google Auth Platform > Clients.
TRACE_DISPLAY_GOOGLE_CLIENT_ID=768829535838-9v4875nkjopo91uobrmggneqodmvec85.apps.googleusercontent.com
TRACE_DISPLAY_OPERATOR_EMAILS=async5855@gmail.com
TRACE_DISPLAY_ALLOWED_ORIGINS=https://trace-log.async5855.workers.dev
# Independent 32+ byte signing key: Secret Manager in production, never a browser.
TRACE_DISPLAY_TOKEN_KEY=
TRACE_MEMORY_CONSENT_VERSION=2026-memory-photo-no-gps-draft-1
# Historical Live/on-site consent versions remain for existing-session operations only.
TRACE_LIVE_CONSENT_VERSION=2026-live-01
TRACE_ON_SITE_CONSENT_VERSION=2026-on-site-01
TRACE_CONSENT_LANGUAGE=ja
# Local draft only: replace with a reviewed, versioned Memory consent before opening intake.
TRACE_CONSENT_BODY=写真による参加の同意文は未承認です。承認済み文面と保存期間を設定するまで新規受付を開始しないでください。
TRACE_CONTACT=運営担当者へお問い合わせください

# Embedded bundle from TRACE_F #61; keep all three versions aligned with /display.
# Feature flags remain off until OAuth, routing and public use are approved.
TRACE_COORDINATE_VERSION=toyosu-2026-08-28.1
TRACE_CAMPUS_GRAPH_VERSION=toyosu-graph-2026-10-26.1.draft
TRACE_THREE_D_MAP_VERSION=toyosu-3dmap-2026-10-26
# 必ず実際のキャンパス境界と3D空間の原点へ変更してください。
TRACE_MIN_LATITUDE=34.9800
TRACE_MAX_LATITUDE=35.0200
TRACE_MIN_LONGITUDE=134.9800
TRACE_MAX_LONGITUDE=135.0200
TRACE_ORIGIN_LATITUDE=35.0000
TRACE_ORIGIN_LONGITUDE=135.0000
TRACE_POSITION_QUANTIZATION_METERS=10
TRACE_MAX_POSITION_ACCURACY_METERS=100

TRACE_LIVE_POSITION_TTL=60s
TRACE_MEMORY_SESSION_TTL=6h
TRACE_LIVE_SESSION_TTL=6h
TRACE_DATA_RETENTION=24h
